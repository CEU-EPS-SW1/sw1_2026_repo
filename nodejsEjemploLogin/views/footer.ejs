<% if (message) { %>
  <div class="alert alert-primary" role="alert">
    <p><%- message %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  
<% } if (error) { %>
    <div class="alert alert-danger" role="alert">
    <p><%- error %></p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>
</body>
</html>